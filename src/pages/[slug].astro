---
import type { GetStaticPaths } from "astro";

import BaseLayout from "../layouts/BaseLayout.astro";

import {
  Project_Gallery,
  Project_Intro,
  Project_Header,
  Project_Info,
} from "../components/projects";

import {
  getProjectBySlug,
  getProjects,
} from "../data/projects";

import { getProjectCover } from "../lib/projects";

import {
  projectJsonLd,
  websiteJsonLd,
} from "../lib/structured-data";


export const getStaticPaths = (async () => {
  const projects = await getProjects();

  return projects.map((project) => ({
    params: {
      slug: project.slug,
    },
  }));
}) satisfies GetStaticPaths;


const project = await getProjectBySlug(
  Astro.params.slug ?? ""
);

if (!project) {
  throw new Error(
    `Project not found: ${Astro.params.slug}`
  );
}

const cover = getProjectCover(project);
---

<BaseLayout
  metadata={{
    title: project.title,
    description: project.description,
    canonical: `/${project.slug}/`,
    openGraph: {
      type: "article",
    },
    socialImage: cover?.src,
  }}
  jsonLd={[
    ...websiteJsonLd(),
    projectJsonLd(project),
  ]}
>
  <Project_Header />

  <main id="main-content">

    <!-- Siempre visible -->
    <Project_Intro project={project} />

    <!-- Galería -->
    <div
      data-project-gallery
      class="
        relative
        z-10
        bg-(--color-background)
      "
    >
      <Project_Gallery images={project.images} />
    </div>

    <!-- Información -->
    <div
      data-project-info-view
      hidden
      class="
        relative
        z-10
        bg-(--color-background)
      "
    >
      <Project_Info project={project} />
    </div>

  </main>
</BaseLayout>


<script>
  const infoButton =
    document.querySelector<HTMLButtonElement>(
      "[data-project-info-trigger]"
    );

  const gallery =
    document.querySelector<HTMLElement>(
      "[data-project-gallery]"
    );

  const info =
    document.querySelector<HTMLElement>(
      "[data-project-info-view]"
    );

  if (infoButton && gallery && info) {
    infoButton.addEventListener("click", () => {
      const openInfo = info.hidden;

      gallery.hidden = openInfo;
      info.hidden = !openInfo;

      infoButton.setAttribute(
        "aria-expanded",
        String(openInfo)
      );
    });
  }
</script>