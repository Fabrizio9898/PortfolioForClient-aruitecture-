---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionContainer from "../components/Section_Container.astro";
import ProjectCollection from "../components/ProjectCollection.astro";
import Hero from "../components/Hero/Hero.astro";
import TitleSection from "../components/TitleSection.astro";
import About from '../components/About/About.astro'
import { site } from "../config/site";
import { getProjects } from "../data/projects";
import { websiteJsonLd } from "../lib/structured-data";

const projects = await getProjects();
const featuredProjects = projects.filter(
  (project) => project.featured
)
---

<BaseLayout
  metadata={{
    title: site.title,
    description: site.description,
    canonical: "/",
  }}
  jsonLd={websiteJsonLd()}
>
  <Hero />

  <main
    id="main-content"
    class="pb-24 md:pb-36"
  >
    <!-- PROYECTOS -->
    <SectionContainer id="proyectos">
 <TitleSection class="text-right">
  Proyectos Destacados
</TitleSection>

<ProjectCollection projects={featuredProjects} />
    </SectionContainer>

    <!-- SOBRE FEDERICO -->
   <SectionContainer id="sobre-mi">
  <TitleSection>
    Sobre Federico
  </TitleSection>

 <About/>
</SectionContainer>
  </main>
</BaseLayout>