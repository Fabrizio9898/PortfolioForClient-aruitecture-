---
import { Image } from "astro:assets";
import { heroSlots } from "../../data/hero";
---

<div
  data-hero-grid
  class="
    grid
    h-[48svh]
    shrink-0
    grid-cols-2
    grid-rows-2

    md:h-[44svh]
    md:grid-cols-3
    md:grid-rows-1
  "
>
  {
    heroSlots.map((slot, index) => (
      <div
        data-hero-slot
        data-slot={index}
        class:list={[
          "relative overflow-hidden",
          index === 3 && "md:hidden",
        ]}
      >
        <div
          data-hero-track
          class="
            absolute
            inset-x-0
            top-0
            h-[200%]
            will-change-transform
          "
        >
          <!-- FIRST -->
          <div class="h-1/2 w-full">
            {
              slot.first.type === "image" ? (
                <Image
                  src={slot.first.image}
                  alt=""
                  class="
                    block
                    h-full
                    w-full
                    object-cover
                  "
                />
              ) : (
                <div
                  class="
                    flex
                    h-full
                    w-full
                    items-center
                    justify-center
                    bg-black
                    px-6
                    text-center
                  "
                >
                  <p
                    class="
                      text-[clamp(1.75rem,7vw,3rem)]
                      font-bold
                      leading-[0.95]
                      tracking-[0.04em]

                      md:text-[clamp(2.5rem,4vw,5rem)]
                      md:tracking-[0.06em]
                    "
                  >
                    {
                      slot.first.lines.map((line) => (
                        <span class="block">
                          {line}
                        </span>
                      ))
                    }
                  </p>
                </div>
              )
            }
          </div>

          <!-- SECOND -->
          <div class="h-1/2 w-full">
            <Image
              src={slot.second.image}
              alt=""
              class="
                block
                h-full
                w-full
                object-cover
              "
            />
          </div>
        </div>
      </div>
    ))
  }
</div>

<script>
  function initHeroGrid() {
    const grid =
      document.querySelector<HTMLElement>(
        "[data-hero-grid]"
      );

    if (!grid) return;

    const slots =
      grid.querySelectorAll<HTMLElement>(
        "[data-hero-slot]"
      );

    if (!slots.length) return;

    const sequenceEl =
      grid.closest<HTMLElement>(
        "[data-hero-sequence]"
      );

    const stageEl =
      grid.closest<HTMLElement>(
        "[data-hero-stage]"
      );

    if (!sequenceEl || !stageEl) return;

    const sequence: HTMLElement =
      sequenceEl;

    const stage: HTMLElement =
      stageEl;

    let targetProgress = 0;
    let currentProgress = 0;
    let rafId = 0;

    const mobile =
      window.matchMedia(
        "(max-width: 767px)"
      );

    const getEase = () =>
      mobile.matches
        ? 0.055
        : 0.075;

    function getScrollProgress() {
      const totalDistance = Math.max(
        sequence.offsetHeight -
          stage.offsetHeight,
        1
      );

      const exitSpace =
        stage.offsetHeight * 0.35;

      const animationDistance = Math.max(
        totalDistance - exitSpace,
        1
      );

      const scrolled =
        -sequence.getBoundingClientRect().top;

      const progress =
        scrolled / animationDistance;

      return Math.min(
        Math.max(progress, 0),
        1
      );
    }

    function render(
      progress: number
    ) {
      const visibleSlots =
        Array.from(slots).filter(
          (slot) =>
            slot.clientHeight > 0
        );

      visibleSlots.forEach(
        (slot, index) => {
          const track =
            slot.querySelector<HTMLElement>(
              "[data-hero-track]"
            );

          if (!track) return;

          const slotProgress =
            Math.min(
              Math.max(
                progress *
                  visibleSlots.length -
                  index,
                0
              ),
              1
            );

          const y =
            slot.clientHeight *
            slotProgress;

          track.style.transform =
            `translate3d(0, -${y}px, 0)`;
        }
      );
    }

    function animate() {
      currentProgress +=
        (
          targetProgress -
          currentProgress
        ) * getEase();

      const difference =
        Math.abs(
          targetProgress -
          currentProgress
        );

      if (
        targetProgress === 1 &&
        currentProgress > 0.985
      ) {
        currentProgress = 1;
      } else if (
        difference < 0.0001
      ) {
        currentProgress =
          targetProgress;
      }

      render(currentProgress);

      if (
        Math.abs(
          targetProgress -
          currentProgress
        ) > 0.0001
      ) {
        rafId =
          requestAnimationFrame(
            animate
          );
      } else {
        rafId = 0;
      }
    }

    function onScroll() {
      targetProgress =
        getScrollProgress();

      if (!rafId) {
        rafId =
          requestAnimationFrame(
            animate
          );
      }
    }

    function onResize() {
      targetProgress =
        getScrollProgress();

      currentProgress =
        targetProgress;

      render(currentProgress);
    }

    window.addEventListener(
      "scroll",
      onScroll,
      { passive: true }
    );

    window.addEventListener(
      "resize",
      onResize
    );

    targetProgress =
      getScrollProgress();

    currentProgress =
      targetProgress;

    render(currentProgress);
  }

  initHeroGrid();
</script>