---
import type { Project } from "../types/project";
import ProjectMedia from "./ProjectMedia.astro";

interface Props {
  project: Project;
  eager?: boolean;
}

const {
  project,
  eager = false,
} = Astro.props;
---

<article
class=" mb-10
    md:mb-14"
>
<a
        href={`/${project.slug}/`}
        aria-label={`Ver proyecto ${project.title}`}
        class="block "
      >
  <!-- IMAGEN -->
  {
    project.coverImage && (
      
        <ProjectMedia
          media={project.coverImage}
          eager={eager}
          sizes="100vw"
          showCaption={false}
        />
    )
  }

  <!-- INFORMACIÓN -->
  <div
    class="
      flex
        items-baseline
        justify-between
        gap-4
        px-2
        py-3
        md:px-3
        md:py-4
    "
  >
    <h3
      class="
        text-base
        font-medium
        md:text-lg
      "
    >
      
        {project.title}
    
    </h3>

    <p
      class="
        shrink-0
        text-sm
        text-(--color-muted)
      "
    >
      {project.year}
    </p>
  </div>
      </a>

</article>