---
import type { Project } from "../types/project";
import ProjectMedia from "./ProjectMedia.astro";

interface Props {
  project: Project;
  eager?: boolean;
}

const { project, eager = false } = Astro.props;
---

<article>
  {project.coverImage && (
    <a href={`/${project.slug}/`} aria-label={`View ${project.title}`}>
      <ProjectMedia media={project.coverImage} eager={eager} sizes="(min-width: 48rem) 50vw, 100vw" />
    </a>
  )}
  <header>
    <h3><a href={`/${project.slug}/`}>{project.title}</a></h3>
    {(project.year || project.location) && (
      <p>{[project.year, project.location].filter(Boolean).join(" · ")}</p>
    )}
  </header>
</article>
