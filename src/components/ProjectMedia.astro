---
import type { Media } from "../types/project";

interface Props {
  media: Media;
  eager?: boolean;
  sizes?: string;
  showCaption?: boolean;
  imageClass?: string;
}

const {
  media,
  eager = false,
  sizes = "100vw",
  showCaption = true,
  imageClass = "",
} = Astro.props;

const srcset = media.sources
  ?.map(({ src, width }) => `${src} ${width}w`)
  .join(", ");
---

<figure>
  <img
    src={media.src}
    srcset={srcset}
    sizes={srcset ? sizes : undefined}
    alt={media.alt}
    width={media.width}
    height={media.height}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : "auto"}
    decoding="async"
    class:list={[
      "block w-full object-cover",
      imageClass || "h-auto",
    ]}
  />

  {showCaption && (media.caption || media.credit) && (
    <figcaption>
      {media.caption}

      {media.caption && media.credit && " — "}

      {media.credit && (
        <span>
          Credit: {media.credit}
        </span>
      )}
    </figcaption>
  )}
</figure>