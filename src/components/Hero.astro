---
import { Image } from "astro:assets";
import { heroSlots } from "../data/hero";
---

<section
  id="hero"
  class="relative bg-black text-white"
>
  <div
    data-hero-sequence
    class="relative h-[300svh]"
  >
    <div
      class="sticky top-0 flex h-svh flex-col overflow-hidden bg-black"
    >
      <!-- GRID -->
      <div
        data-hero-grid
        class="
          grid
          h-[48svh]
          shrink-0
          grid-cols-2
          grid-rows-2

          md:h-[44svh]
          md:grid-cols-3
          md:grid-rows-1
        "
      >
        {
          heroSlots.map((slot, index) => (
            <div
              data-hero-slot
              data-slot={index}
              class:list={[
                "relative overflow-hidden",
                index === 3 && "md:hidden",
              ]}
            >
              {slot.first.type === "image" ? (
                <Image
                  src={slot.first.image}
                  alt=""
                  class="h-full w-full object-cover"
                />
              ) : (
                <div
                  class="
                    flex h-full w-full
                    items-center justify-center
                    bg-black
                    px-6 text-center
                  "
                >
                 <p
    class="
      text-[clamp(1.75rem,7vw,3rem)]
      font-bold
      leading-[0.95]
      tracking-[0.04em]

      md:text-[clamp(2.5rem,4vw,5rem)]
      md:tracking-[0.06em]
    "
  >
    {slot.first.lines.map((line) => (
      <span class="block">{line}</span>
    ))}
  </p>
                </div>
              )}
            </div>
          ))
        }
      </div>

      <!-- HEADER -->
      <header
        data-site-header
        class="
          flex
          shrink-0
          items-center
          justify-between
          px-4
          py-4
          md:px-6
        "
      >
        <a href="/">
          Inicio
        </a>

        <nav class="hidden md:block">
          <ul class="flex items-center gap-4">
            <li>
              <a href="#proyectos">Proyectos</a>
            </li>

            <li>
              <a href="#sobre-mi">Información</a>
            </li>
          </ul>
        </nav>

        <button type="button">
          Menu
        </button>
      </header>

      <!-- ESPACIO NEGRO -->
      <div class="flex-1"></div>

      <!-- FOOTER -->
    <footer
  data-hero-footer
  class="
    flex
    shrink-0
    items-end
    justify-between
    gap-6
    px-4
    pb-4
    md:px-6
    md:pb-6
  "
>
  <span class="shrink-0">
    ●
  </span>

  <div
    class="
      flex
      min-w-0
      items-end
      justify-end
      gap-3
      md:gap-5
    "
  >
    <p
      class="
        max-w-[16rem]
        text-right
        text-sm
        leading-tight
        md:max-w-none
        md:text-base
      "
    >
Aquitectura, Diseño, Dirección de obra
    </p>

    <span class="shrink-0">
      ↓
    </span>
  </div>
</footer>
    </div>
  </div>
</section>