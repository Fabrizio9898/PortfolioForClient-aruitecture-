---
import type { Project } from "../types/project";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const metadata = [
  ["Año", project.year],
  ["Ubicación", project.location],
  ["Estado", project.status],
  ["Cliente", project.client],
  ["Tipología", project.projectType],
  ["Superficie del terreno", project.siteArea],
  ["Superficie construida", project.builtArea],
].filter((entry): entry is [string, string | number] => entry[1] !== undefined);
---

{metadata.length > 0 && (
  <dl>
    {metadata.map(([label, value]) => (
      <div>
        <dt>{label}</dt>
        <dd>{label === "Tipología" ? <span class="accent-category">{value}</span> : value}</dd>
      </div>
    ))}
  </dl>
)}

<style>
  dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem 1rem; }
  dl > div { border-top: 1px solid var(--color-border); padding-top: 0.75rem; }
  dt { color: var(--color-muted); font-size: 0.75rem; margin-bottom: 0.5rem; }
  dd { font-size: 0.9375rem; overflow-wrap: anywhere; }
</style>
