---
interface Props {
  as?: "h1" | "h2" | "h3";
  class?: string;
}

const {
  as: Tag = "h2",
  class: className = "",
} = Astro.props;
---

<Tag
  class:list={[
    "mb-6",
    "text-3xl",
    "font-medium",
    "leading-tight",
    "tracking-tight",
    "text-(--color-foreground)",
    className,
  ]}
>
  <slot />
</Tag>