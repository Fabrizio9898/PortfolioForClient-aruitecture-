---
import type { Project } from "../types/project";
import ProjectPreview from "./ProjectPreview.astro";
import BracketLink from './ui/BracketLink.astro'
interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<div class="flex flex-col">
  <!-- PROYECTOS -->
  <div class="flex flex-col">
    {
      projects.map((project, index) => (
        <ProjectPreview
          project={project}
          eager={index === 0}
        />
      ))
    }
  </div>

  <div
    class="
      flex
      justify-end
    "
  >
   <BracketLink href="/proyects">
  Ver todos los proyectos
</BracketLink>
  </div>
</div>