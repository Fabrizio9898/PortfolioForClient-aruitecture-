---
import type { Media } from "../types/project";
import ProjectMedia from "./ProjectMedia.astro";

interface Props {
  images: Media[];
  startIndex?: number;
}

const { images, startIndex = 1 } = Astro.props;
---

{images.length > 0 && (
  <section aria-label="Galería del proyecto" class="project-gallery">
    {images.map((image, index) => (
      <div class="gallery-item">
        <ProjectMedia media={image} showCaption={false} />
        <div class="image-caption">
          <span class="image-number">{String(startIndex + index).padStart(2, "0")}</span>
          <p>{image.caption ?? image.alt}{image.credit && <span> — {image.credit}</span>}</p>
        </div>
      </div>
    ))}
  </section>
)}

<style>
  .project-gallery { display: grid; gap: 2rem 1.25rem; }
  .gallery-item { min-width: 0; }
  .image-caption { display: flex; gap: 1rem; padding-top: 0.75rem; color: var(--color-muted); font-size: 0.75rem; }
  .image-number { color: var(--color-accent-primary); font-variant-numeric: tabular-nums; }
  @media (min-width: 768px) {
    .project-gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 3rem; }
    .gallery-item:nth-child(3n + 1) { grid-column: 1 / -1; }
  }
</style>
