---

import type { HTMLAttributes } from "astro/types";


interface Props extends Omit<HTMLAttributes<"a">, "class"> {
  href?: string;
  type?: "button" | "submit" | "reset";
  class?: string;
  selected?: boolean;
tone?: "accent" | "neutral" | "footer";
size?: "md" | "lg";
}

const {
  href,
  type = "button",
  class: className = "",
  selected = false,
  size = "md",
    tone = "accent",

  ...attrs
} = Astro.props;

const Tag = href ? "a" : "button";
---

<Tag
  href={href}
  type={href ? undefined : type}
  class:list={[
    "bracket-link",
    `bracket-link--${tone}`,
`bracket-link--${size}`,
    { "is-selected": selected },
    className,
  ]}
  {...attrs}
>
  <span class="bracket-link__text">
    <slot />
  </span>
</Tag>

<style>
  .bracket-link {
    position: relative;
    display: inline-flex;
    width: fit-content;
    max-width: 100%;
    align-items: center;
    justify-content: center;

    border: 0;
    padding: 0.5rem 1rem;

    background: transparent;
    color: var(--color-foreground);

    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1;

    white-space: nowrap;
    cursor: pointer;
  }

  .bracket-link::before,
  .bracket-link::after {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);

    color: var(--color-accent-primary);

    transition:
      color 180ms ease,
      transform 220ms ease;
  }

  .bracket-link::before {
    content: "[";
    left: 0;
  }

  .bracket-link::after {
    content: "]";
    right: 0;
  }

  .bracket-link__text {
    padding: 0.25rem 0.4rem;
  }


  /* =========================
     ACCENT
  ========================= */

  @media (hover: hover) {
    .bracket-link:hover {
      color: var(--color-accent-primary);
    }
  }


  /* =========================
     NEUTRAL
  ========================= */

  .bracket-link--neutral {
    color: var(--color-foreground);
  }

  .bracket-link--neutral::before,
  .bracket-link--neutral::after {
    color: currentColor;
  }

  @media (hover: hover) {
    .bracket-link--neutral:hover {
      color: inherit;
      opacity: 0.7;
    }
  }


  /* =========================
     FOOTER
  ========================= */

  .bracket-link--footer {
    color: #f5f5f5 !important;

    font-size: clamp(2rem, 4vw, 4rem) !important;
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.04em;

    padding: 0.5rem 1.25rem;
  }

  .bracket-link--footer::before,
  .bracket-link--footer::after {
    color: #f5f5f5 !important;
    font-size: 1em;
    font-weight: 300;
  }

  .bracket-link--footer .bracket-link__text {
    color: #f5f5f5 !important;
  }

  @media (hover: hover) {

    .bracket-link--footer:hover {
      color: #f5f5f5 !important;
      opacity: 1;
    }

    .bracket-link--footer:hover::before {
      transform:
        translateY(-50%)
        translateX(-4px);
    }

    .bracket-link--footer:hover::after {
      transform:
        translateY(-50%)
        translateX(4px);
    }
  }


  /* =========================
     SELECTED
  ========================= */

  .bracket-link.is-selected .bracket-link__text,
  .bracket-link[aria-expanded="true"] .bracket-link__text,
  .bracket-link[aria-pressed="true"] .bracket-link__text {
    background: var(--color-accent-primary);
    color: var(--color-accent-foreground);
  }

.bracket-link--lg {
  font-size: clamp(1.5rem, 4vw, 2.5rem);
  padding: 0.75rem 1.5rem;
}

  /* =========================
     MOBILE
  ========================= */

  @media (max-width: 767px) {

    .bracket-link {
      padding: 0.5rem 0.75rem;
    }

    .bracket-link--footer {
      font-size: 2.5rem !important;
      line-height: 0.95;
      letter-spacing: -0.04em;
    }

    .bracket-link--lg {
  font-size: 1.75rem;
  padding: 0.75rem 1.25rem;
}
  }
</style>