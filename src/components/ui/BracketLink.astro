---
interface Props {
  href?: string;
  type?: "button" | "submit" | "reset";
  class?: string;
  selected?: boolean;
}

const {
  href,
  type = "button",
  class: className = "",
  selected = false,
  ...attrs
} = Astro.props;

const Tag = href ? "a" : "button";
---

<Tag
  href={href}
  type={href ? undefined : type}
  class:list={[
    "bracket-link",
    { "is-selected": selected },
    className,
  ]}
  {...attrs}
>
  <span class="bracket-link__text">
    <slot />
  </span>
</Tag>

<style>
  .bracket-link {
    position: relative;

    display: inline-flex;
    width: fit-content;
    max-width: 100%;

    align-items: center;
    justify-content: center;

    border: 0;
    padding: 0.5rem 1rem;

    background: transparent;
    color: var(--color-foreground);

    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1;

    white-space: nowrap;
    cursor: pointer;
  }

  .bracket-link::before,
  .bracket-link::after {
    position: absolute;

    color: var(--color-accent-primary);

    transition: color 180ms ease;
  }

  .bracket-link::before {
    content: "[";
    left: 0;
  }

  .bracket-link::after {
    content: "]";
    right: 0;
  }

  .bracket-link__text {
    padding: 0.25rem 0.4rem;

    transition:
      color 180ms ease,
      background-color 180ms ease;
  }

  /* Hover simple */
  @media (hover: hover) {
    .bracket-link:hover {
      color: var(--color-accent-primary);
    }
  }

  /* Estado seleccionado explícito */
  .bracket-link.is-selected .bracket-link__text,
  .bracket-link[aria-expanded="true"] .bracket-link__text,
  .bracket-link[aria-pressed="true"] .bracket-link__text {
    background: var(--color-accent-primary);
    color: var(--color-accent-foreground);
  }

  /* En selected los brackets siguen visibles */
  .bracket-link.is-selected::before,
  .bracket-link.is-selected::after,
  .bracket-link[aria-expanded="true"]::before,
  .bracket-link[aria-expanded="true"]::after,
  .bracket-link[aria-pressed="true"]::before,
  .bracket-link[aria-pressed="true"]::after {
    color: var(--color-accent-primary);
  }

  @media (max-width: 767px) {
    .bracket-link {
      padding: 0.5rem 0.75rem;
      font-size: 0.8125rem;
    }
  }
</style>