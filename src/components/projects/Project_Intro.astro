---
import type { Project } from "../../types/project";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<section
  class="
    sticky
    top-(--project-header-height)
    z-0

    flex
    min-h-80
    flex-col

    bg-(--color-background)

    px-(--page-padding)
    pt-4
    pb-8

    md:min-h-105
  "
>
  <h1
    class="
      text-3xl
      font-semibold
      leading-none
      tracking-tight

      md:text-5xl
    "
  >
    {project.title}
  </h1>

  {project.location && (
    <p
      class="
        mt-3
        max-w-[12ch]

        text-3xl
        font-semibold
        leading-[1.05]
        tracking-tight

        text-(--color-muted)

        md:text-5xl
      "
    >
      {project.location}
    </p>
  )}
</section>